generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id        String  @id @default(cuid())
  clerkId   String  @unique
  firstName String?
  lastName  String?
  email     String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repartitions Repartition[]
}

model Repartition {
  id             String           @id @default(cuid())
  type           String
  country        String
  schoolYear     String
  level          String
  lessonsPerWeek Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  teacherId      String
  teacher        Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  rows           RepartitionRow[]

  @@index([teacherId, createdAt])
}

model RepartitionRow {
  id            String      @id @default(cuid())
  week          Int
  startDate     DateTime
  endDate       DateTime
  unit          String
  lessons       String
  repartitionId String
  repartition   Repartition @relation(fields: [repartitionId], references: [id], onDelete: Cascade)

  @@unique([repartitionId, week])
  @@index([repartitionId])
}
